<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-10 text-center text-3xl font-bold bg-gradient-to-r from-blue-400 to-blue-600 bg-clip-text text-transparent">
      <%= t('.title') %>
    </h2>
    <p class="mt-2 text-center text-sm text-slate-400">
      <%= t('.subtitle') %>
    </p>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="rounded-2xl border border-slate-700 bg-slate-800 p-8 shadow-2xl">
      <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :password, t('.password_label'), class: "mb-2 block text-sm font-medium text-slate-300" %>
          <%= form.password_field :password,
              required: true,
              autofocus: true,
              autocomplete: "new-password",
              placeholder: t('.password_placeholder'),
              minlength: 8,
              maxlength: 72,
              class: "block w-full rounded-lg border border-slate-600 bg-slate-700 px-4 py-3 text-white placeholder:text-slate-400 focus:border-transparent focus:ring-2 focus:ring-blue-500 sm:text-sm sm:leading-6" %>
        </div>

        <div>
          <%= form.label :password_confirmation, t('.password_confirmation_label'), class: "mb-2 block text-sm font-medium text-slate-300" %>
          <%= form.password_field :password_confirmation,
              required: true,
              autocomplete: "new-password",
              placeholder: t('.password_confirmation_placeholder'),
              minlength: 8,
              maxlength: 72,
              class: "block w-full rounded-lg border border-slate-600 bg-slate-700 px-4 py-3 text-white placeholder:text-slate-400 focus:border-transparent focus:ring-2 focus:ring-blue-500 sm:text-sm sm:leading-6" %>
        </div>

        <%= form.submit t('.save_button'), class: "w-full cursor-pointer rounded-lg bg-gradient-to-r from-blue-600 to-blue-500 px-4 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:scale-[1.02] hover:from-blue-500 hover:to-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800" %>
      <% end %>

      <div class="mt-6 text-center">
        <%= link_to t('.back_to_sign_in'), new_session_path, class: "text-sm font-medium text-blue-400 transition-colors hover:text-blue-300" %>
      </div>
    </div>
  </div>
</div>
