# Database
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3307
DATABASE_USERNAME=mariadb
DATABASE_PASSWORD=mariadb
DATABASE_NAME=mariadb

# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Transactional emails (Resend SMTP)
# SMTP_PASSWORD is the Resend API key and must only be configured on the server.
APP_HOST=progit.club
APP_PROTOCOL=https
MAILER_FROM="ProGit <noreply@progit.club>"
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_DOMAIN=progit.club
SMTP_USERNAME=resend
SMTP_PASSWORD=your_resend_api_key_here
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SOLID_QUEUE_IN_PUMA=1
